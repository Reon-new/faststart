# Legacy filename — prefer `.env.example`.
# Kept so older docs/scripts that copy `env.example` still work.
DATABASE_URI="sqlite:///database.db"
SECRET_KEY="YouShouldChangeThisSecretKeyToSomethingLongAndRandom"
ENV="development"
APP_PORT=5000
# Hosted checkout credentials. Use Stripe test keys and the PayPal sandbox by default.
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
# Ops console at /config — leave empty to disable the panel
CONFIG_PASSWORD=""
